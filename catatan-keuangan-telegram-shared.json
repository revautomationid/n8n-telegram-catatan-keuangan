        "descriptionType": "manual",
        "toolDescription": "Gunakan tool ini JIKA pengguna menanyakan total pengeluaran (hari ini, minggu ini, bulan ini, dll). Kamu harus mengubah rentang waktu yang diminta pengguna menjadi 2 argumen: 'waktu_mulai' (YYYY-MM-DD) dan 'waktu_akhir' (YYYY-MM-DD).",
        "operation": "executeQuery",
        "query": "SELECT SUM(total_belanja) AS total_pengeluaran, COUNT(id) AS jumlah_transaksi\nFROM catatan_keuangan\nWHERE tanggal >= $1 AND tanggal <= $2 AND no_hp = $3;",
        "options": {
          "queryReplacement": "={{ [ $fromAI('waktu_mulai', 'Tanggal awal format YYYY-MM-DD', 'string'), $fromAI('waktu_akhir', 'Tanggal akhir format YYYY-MM-DD', 'string'), String($('Telegram Trigger').first().json.message.from.id) ] }}"
